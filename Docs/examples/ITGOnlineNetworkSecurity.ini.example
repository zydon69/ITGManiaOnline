# Signed runtime network security override for ITG Online.
# Deploy as:
#   Save/ITGOnlineNetworkSecurity.ini
# with matching signature:
#   Save/ITGOnlineNetworkSecurity.ini.sig
#
# Note:
# - This file is NOT auto-generated by the client.
# - Unsigned or invalid signatures are ignored by the client.

http_public_key_pins=itgonline.fr=<sha256_spki_hex_current>,itgonline.fr=<sha256_spki_hex_next>,*.itgonline.fr=<sha256_spki_hex_current>,*.itgonline.fr=<sha256_spki_hex_next>
http_allow_hosts=itgonline.fr,*.itgonline.fr,*.groovestats.com,*.itgmania.com
